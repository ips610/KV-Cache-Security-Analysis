__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.claude/
.superpowers/

# Third-party checkouts created by the setup scripts. Neither project is
# distributed with this repository (see external/README.md).
external/KVCOMM/
external/CacheBlend/

# Experiment output trees: hundreds of MB of generated artifacts per sweep.
# Sync them between machines with scp/rsync, not through this repo.
runs/
result/
results/
dense_validation_results/
dense_kvcomm_comparison/
logs/
# Any sweep tree pasted at the repo root: these hold Latency.json plus per-task
# reports. Match by content, not by name, so a tree dropped under a new name is
# still excluded.
**/report_discrepancy_summary.json
**/manifest.json
# Archives of the trees above.
*.zip

# Datasets are not distributed; the build scripts regenerate them. Keep every
# built or exported data file out of the repo.
datasets/primevul/raw/
datasets/**/*.jsonl
datasets/**/manifest.json
datasets/**/validator_prompt_spec/
datasets/**/frozen_validator_inputs/

# Staged report summaries written by experiments/collect_reports.py.
docs/experiment_reports/
