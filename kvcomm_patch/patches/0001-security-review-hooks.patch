+    def sampling_kwargs(self, temperature):
+        """Return ``do_sample``/``temperature`` for this agent's generation.
+
+        Decoding is greedy by default, which makes the seed inert and every run
+        byte-identical. Sampling is opt-in per agent **role** via the environment:
+
+            KVCOMM_SAMPLE_ROLES="Security Validator"   # comma-separated
+            KVCOMM_SAMPLE_TEMPERATURE=0.7
+
+        Restricting sampling to the validator is deliberate: the generator stays
+        greedy, so the code under review is byte-identical across every arm,
+        repetition and threshold, while the validator's repetitions genuinely
+        differ and the dense-vs-dense noise floor becomes measurable.
+        """
+        roles = [r.strip() for r in os.environ.get("KVCOMM_SAMPLE_ROLES", "").split(",") if r.strip()]
+        if not roles or getattr(self, "role", None) not in roles:
+            return {"do_sample": False, "temperature": temperature}
+        sample_temp = float(os.environ.get("KVCOMM_SAMPLE_TEMPERATURE", 0.7))
+        return {"do_sample": True, "temperature": sample_temp, "top_p": 1.0}
