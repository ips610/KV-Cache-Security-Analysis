+        source_agent_id: str,
+        audit_key: str,
+    ) -> str:
+        """Orchestration-owned gate for PrimeVul Agent 2.
+
+        Agent 1 never calls this method.  It compares Agent 1's bare-code KV
+        with the validator's existing code-placeholder anchors and records the
+        same decision state used by ``set_anchor``.
+        """
+        package = self.get_bare_code_package(
+            request_uid=request_uid, source_agent_id=source_agent_id
+        )
+        state = self.get_request_state(request_uid)
+        ph_id = f"agent_{source_agent_id}_current"
+        anchors = state.anchors.setdefault(ph_id, {})
+        lengths = state.anchor_len_dict.setdefault(ph_id, {})
+        infos = state.anchor_info_dict.setdefault(ph_id, {})
+        anchor_keys = list(anchors.keys())
+        anchor_lengths = [lengths.get(key, [0, 0]) for key in anchor_keys]
+        activated = list(infos.values())
+        dense, activated = self.kv_engine.predict_as_anchor(
+            package.kv_cache,
+            anchor_kv_cache_list=list(anchors.values()),
+            anchor_len_list=anchor_lengths,
+            anchor_activated_list=activated,
+        )
+        state.anchor_dict.setdefault(ph_id, {})[audit_key] = dense
+        global_info = state.global_anchor_info.setdefault(ph_id, {})
+        if dense:
+            infos[audit_key] = 0
+            global_info[audit_key] = [0, package.token_count]
+            return "dense_prefill"
+
+        required = {
+            f"{self.node_id}_ph_key_delta",
+            f"{self.node_id}_ph_value_delta",
+            f"{self.node_id}_pf_key_delta",
+            f"{self.node_id}_pf_value_delta",
+        }
+        eligible = [
+            anchors[key]
+            for key, length in zip(anchor_keys, anchor_lengths)
+            if length[0] >= package.token_count
+        ]
+        if not eligible or any(not required.issubset(entry) for entry in eligible):
+            raise RuntimeError(
+                "PrimeVul gate selected KV reuse without a genuine compatible anchor delta."
+            )
+        for index, key in enumerate(list(infos.keys())):
+            if index < len(activated):
+                infos[key] = activated[index]
+                global_info.setdefault(key, [0, 0])[0] = activated[index]
+        return "kv_reuse"
