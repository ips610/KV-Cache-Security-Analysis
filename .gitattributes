# These files are consumed on Linux. CRLF breaks them in ways that are slow to
# diagnose: a shell script with CRLF fails with "bad interpreter", and `git
# apply` rejects a patch whose line endings do not match the target file.
# This repo is developed partly on Windows with core.autocrlf=true, so pin them.
*.sh                      text eol=lf
*.patch                   -text
# The overlay is copied byte-for-byte into the upstream KVCOMM checkout, whose
# files are LF; keep it LF so sha256 checks in setup_kvcomm.sh stay stable.
kvcomm_patch/overlay/**   text eol=lf
# Prompt specs and frozen inputs are sha256-pinned by their producers.
*.json                    text eol=lf
*.jsonl                   text eol=lf
